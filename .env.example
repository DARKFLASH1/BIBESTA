# BIBESTA — configuration d'environnement (modèle)
# Copier ce fichier vers `.env`, puis remplacer les valeurs par des secrets réels.
# `docker compose up --env-file .env` est le mode par défaut de docker compose.

# ─── Base de données MySQL ─────────────────────────────
# Mot de passe du compte root MySQL (container uniquement).
MYSQL_ROOT_PASSWORD=changez_moi
# Nom de la base créée au démarrage.
MYSQL_DATABASE=bibliotheque
# Utilisateur applicatif.
MYSQL_USERNAME=bibesta_app
# Mot de passe de l'utilisateur applicatif.
MYSQL_PASSWORD=changez_moi

# ─── JWT ───────────────────────────────────────────────
# Clé de signature des tokens (au moins 256 bits / 32 caractères).
# Générer : openssl rand -base64 48
JWT_SECRET=changez_moi
# Durée de validité d'un token en millisecondes.
JWT_EXPIRATION=86400000

# ─── CORS ──────────────────────────────────────────────
# Origines autorisées, séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ─── Profil Spring ─────────────────────────────────────
# dev | prod
APP_PROFILE=prod