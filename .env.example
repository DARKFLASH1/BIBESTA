# ============================================================
# BIBESTA — Variables d'environnement (exemple)
# Copier ce fichier vers .env et remplir les valeurs réelles.
# .env NE DOIT JAMAIS ÊTRE VERSIONNÉ (déjà dans .gitignore).
# ============================================================

# Base de données MySQL
MYSQL_ROOT_PASSWORD=root_password_ici
MYSQL_DATABASE=bibliotheque
MYSQL_USERNAME=bibesta_app
MYSQL_PASSWORD=db_password_ici

# Backend Spring Boot
APP_PROFILE=prod
# Générer : openssl rand -base64 48 (minimum 32 caractères)
JWT_SECRET=jwt_secret_min_32_caracteres_aleatoires_ici
# Durée de validité d'un token en millisecondes.
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Chaîne JDBC (générée automatiquement dans docker-compose, surcharge optionnelle)
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/bibliotheque?useSSL=false&serverTimezone=UTC&zeroDateTimeBehavior=convertToNull
